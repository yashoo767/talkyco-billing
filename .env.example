# ──────────────────────────────────────────────────────────────────────────────
# Talkyco Billing — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://talkyco:CHANGE_ME@localhost:5432/talkyco_billing"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# ── Messaging provider credentials (server-side only, NEVER exposed to browser)
# Account SID from your messaging provider dashboard
MESSAGING_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Auth token from your messaging provider dashboard
MESSAGING_AUTH_TOKEN="your_auth_token_here"

# ── Rate limiting configuration
# Max requests per IP per minute (public lookup)
RATE_LIMIT_IP_PER_MINUTE="20"
# Max requests per phone number per hour
RATE_LIMIT_PHONE_PER_HOUR="60"
# Max requests per IP per hour (hard cap)
RATE_LIMIT_IP_PER_HOUR="200"
# Temporary block duration in seconds after abuse detection
RATE_LIMIT_BLOCK_SECONDS="300"

# ── Cache TTL (seconds)
CACHE_TTL_TODAY="120"
CACHE_TTL_YESTERDAY="900"
CACHE_TTL_HISTORICAL="3600"

# ── Date range limits
# Maximum days allowed in a single query (prevents API abuse)
MAX_DATE_RANGE_DAYS="31"

# ── Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
